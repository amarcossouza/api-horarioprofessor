[Unit]
Description=Horario Professor - API (porta 5311, somente local)
After=network.target mysql.service

[Service]
WorkingDirectory=/var/www/horarioprofessor-api
ExecStart=/var/www/horarioprofessor-api/API-HorarioProfessor
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=horarioprofessor-api
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=HOME=/var/www/horarioprofessor-api
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target
